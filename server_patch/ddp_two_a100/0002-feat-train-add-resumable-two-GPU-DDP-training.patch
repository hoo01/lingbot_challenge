+class DistributedEpochBatchSampler(Sampler):
+    """Deterministic disjoint per-rank batches with an exactly resumable offset."""
+    def __init__(self, length, batch_size, seed, rank, world_size, epoch=0, offset=0):
+        if length <= 0 or batch_size <= 0:
+            raise ValueError("Dataset length and batch size must be positive.")
+        if world_size <= 1 or not 0 <= rank < world_size:
+            raise ValueError("Distributed sampler requires world_size > 1 and a valid rank.")
+        self.length, self.batch_size, self.seed = length, batch_size, seed
+        self.rank, self.world_size = rank, world_size
+        self.epoch, self.offset = epoch, offset
+        self.global_batches = length // (batch_size * world_size)
+        if self.global_batches <= 0:
+            raise ValueError("Dataset must contain at least one complete distributed global batch.")
+        if not 0 <= offset <= self.global_batches:
+            raise ValueError("Distributed batch offset is outside this epoch.")
+
+    def __iter__(self):
+        order = torch.randperm(self.length, generator=torch.Generator().manual_seed(self.seed + self.epoch)).tolist()
+        width = self.batch_size * self.world_size
+        for batch_index in range(self.offset, self.global_batches):
+            global_batch = order[batch_index * width:(batch_index + 1) * width]
+            start = self.rank * self.batch_size
+            yield global_batch[start:start + self.batch_size]
+
+    def __len__(self):
+        return self.global_batches - self.offset
+
+
+def epoch_dataloader(dataset, batch_size, seed, epoch=0, offset=0, num_workers=0,
+                     collate_fn=model_collate, rank=0, world_size=1):
