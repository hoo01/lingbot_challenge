+"""CPU checks for DDP metadata and rank-specific checkpoint RNG state."""
+from copy import deepcopy
+from pathlib import Path
+import random
+import sys
+
+import numpy as np
+import torch
+from torch import nn
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from lrvla.training_checkpoint import (capture_rng_state, resume_training_checkpoint,
+                                       save_training_checkpoint)
+from lrvla.training_distributed import DistributedContext, distributed_metadata
+from lrvla.training_identity import repository_identity
+
+
+def metadata(world_size=2):
+    return {
+        "base_identity": {"sha256": "base"},
+        "manifest_content_sha256": "clean",
+        "selection": {"mode": "expert"},
+        "norm_sha256": "norm",
+        "model_geometry": {"chunk_size": 50},
+        "qwen_config_sha256": "qwen",
+        "loss_normalization": "valid_action_coordinate_mean_v1",
+        "data_sampling": {"action_chunk_tail": "mask", "batch_size": 16},
+        "distributed": distributed_metadata(
+            DistributedContext(0, 0, world_size, torch.device("cpu")), 16, 1),
+    }
+
+
+def test_distributed_metadata_tracks_effective_global_batch():
+    data = metadata(2)["distributed"]
+    assert data["world_size"] == 2
+    assert data["per_device_batch_size"] == 16
+    assert data["global_batch_size"] == 32
+    assert data["sampler"] == "global_shuffle_rank_slice_drop_last"
+
+
+def test_repository_identity_records_revision(tmp_path):
+    import subprocess
+    subprocess.run(["git", "init", "-q", str(tmp_path)], check=True)
+    (tmp_path / "tracked.txt").write_text("baseline\n")
+    subprocess.run(["git", "-C", str(tmp_path), "add", "tracked.txt"], check=True)
+    subprocess.run(["git", "-C", str(tmp_path), "-c", "user.name=test", "-c", "user.email=test@example.com",
+                    "commit", "-qm", "baseline"], check=True)
