From: hoo01 <497458301@qq.com>
Date: Tue, 6 Oct 2026 16:58:35 +0800
Subject: [PATCH] fix(download): honor configurable Hugging Face endpoint

---
 scripts/download_assets.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/scripts/download_assets.py b/scripts/download_assets.py
index 13cdd3f..bc65dac 100755
--- a/scripts/download_assets.py
+++ b/scripts/download_assets.py
@@ -10,6 +10,7 @@ import argparse
 from concurrent.futures import ThreadPoolExecutor
 import hashlib
 import json
+import os
 from pathlib import Path
 import re
 import shutil
@@ -18,6 +19,7 @@ from urllib.parse import quote
 from urllib.request import Request, urlopen
 
 ROOT = Path(__file__).resolve().parents[1]
+HF_ENDPOINT = os.environ.get("HF_ENDPOINT", "https://huggingface.co").rstrip("/")
 BASE_REPO = "robbyant/lingbot-vla-v2-6b"
 BASE_REV = "11c703bf6a5c1f45b3b69168482da11fdbba53d7"
 QWEN_REPO = "Qwen/Qwen3-VL-4B-Instruct"
@@ -32,7 +34,7 @@ def request_json(url: str):
 
 
 def hf_metadata(repo: str, kind: str, revision: str) -> dict:
-    result = request_json(f"https://huggingface.co/api/{kind}s/{repo}/revision/{revision}?blobs=true")
+    result = request_json(f"{HF_ENDPOINT}/api/{kind}s/{repo}/revision/{revision}?blobs=true")
     if result.get("sha") != revision:
         raise RuntimeError(f"Requested immutable revision {revision}, API returned {result.get('sha')}")
     return result
@@ -150,7 +152,7 @@ def main():
             if filename.startswith("/") or ".." in Path(filename).parts:
                 raise ValueError("Unsafe repository path")
             prefix = "datasets/" if job["kind"] == "dataset" else ""
-            url = f"https://huggingface.co/{prefix}{job['repo']}/resolve/{job['revision']}/{quote(filename)}"
+            url = f"{HF_ENDPOINT}/{prefix}{job['repo']}/resolve/{job['revision']}/{quote(filename)}"
             digest = item.get("lfs", {}).get("sha256")
             return download_file(url, job["destination"] / filename, item["size"], digest)
         with ThreadPoolExecutor(max_workers=args.workers) as pool:
